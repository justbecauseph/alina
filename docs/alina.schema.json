{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/justbecauseph/alina/main/docs/alina.schema.json",
  "title": "Haruhi content bundle with Alina's extensions",
  "description": "A haruhi content bundle (haruhi's docs/bundle.schema.json) whose extensions object holds Alina's three sections, alina:guild, alina:achievements and alina:trade. It checks the shape of each value. Validation on the server also checks what this schema cannot: that each board's graph (or settings.board_graph) names a graph in the bundle, that every commission belongs to exactly one board, that volumes, tabs and parents exist, that triggers are registered and their conditions parse, that loot tables, tags and effects exist, that a counted criterion uses an event trigger, that tier counts rise, that requirements name the achievement's criteria, that the currency has a denomination of value 1, that a trade rule's namespace has registered items, and that no experience rate or offer lets a player mint Aur.",
  "allOf": [
    { "$ref": "https://raw.githubusercontent.com/justbecauseph/haruhi/main/docs/bundle.schema.json" },
    {
      "properties": {
        "extensions": {
          "properties": {
            "alina:guild": { "$ref": "#/$defs/guild" },
            "alina:achievements": { "$ref": "#/$defs/achievements" },
            "alina:trade": { "$ref": "#/$defs/trade" }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$"
    },
    "text": {
      "description": "A text component: a plain string, a component object or an array of components.",
      "type": ["string", "object", "array"]
    },
    "duration": {
      "description": "A positive ISO-8601 duration of at most 3650 days, such as PT20H or P7D.",
      "type": "string",
      "pattern": "^(?!P(0+D)?(T(0+H)?(0+M)?(0+(\\.0+)?S)?)?$)P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
    },
    "reward": {
      "type": "object",
      "properties": {
        "loot_table": { "$ref": "#/$defs/id", "description": "Rolled once with the settlement operation's seed. Must exist on the server." },
        "reputation": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "trigger": { "$ref": "#/$defs/id", "description": "A registered criterion trigger, vanilla or Alina's." },
        "conditions": { "type": "object", "description": "The trigger's conditions, exactly as in a vanilla advancement." },
        "count": { "type": "integer", "minimum": 1, "default": 1, "description": "Matching events needed. Above 1 only for event triggers." }
      },
      "required": ["trigger"],
      "additionalProperties": false
    },
    "guild": {
      "description": "Guild settings, commissions, world volumes and boards.",
      "type": "object",
      "properties": {
        "settings": { "$ref": "#/$defs/settings" },
        "commissions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/commission" }
        },
        "volumes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/volume" }
        },
        "boards": {
          "description": "Notice boards, each with its own pool and daily draw. Without boards, the section has one implicit board that takes settings.board_graph.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/board" }
        }
      },
      "required": ["settings"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["boards"] },
          "then": { "properties": { "settings": { "not": { "required": ["board_graph"] } } } },
          "else": { "properties": { "settings": { "required": ["board_graph"] } } }
        }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "board_size": { "type": "integer", "minimum": 1, "default": 5 },
        "active_cap": { "type": "integer", "minimum": 1, "default": 3 },
        "reset": {
          "type": "object",
          "properties": {
            "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$", "default": "04:00" },
            "zone": { "type": "string", "default": "Asia/Manila", "description": "A time zone id." }
          },
          "additionalProperties": false
        },
        "default_cooldown": { "$ref": "#/$defs/cooldown" },
        "salt": { "type": "string", "default": "" },
        "board_graph": {
          "$ref": "#/$defs/id",
          "description": "The graph the implicit board's Notice Boards open; must be in the bundle. Required without boards, not allowed with them."
        },
        "board_reach": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "default": 6,
          "description": "How far a player may move from a Notice Board, in blocks. The default reach of every board."
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/text", "description": "The name staff commands show. Default: the board's id." },
        "graph": { "$ref": "#/$defs/id", "description": "The graph the board's Notice Boards open; must be in the bundle." },
        "size": { "type": "integer", "minimum": 1, "description": "Commissions drawn each day. Default: settings.board_size." },
        "reach": { "type": "number", "exclusiveMinimum": 0, "maximum": 64, "description": "Default: settings.board_reach." },
        "categories": {
          "description": "The categories whose commissions are in the pool.",
          "type": "array",
          "items": { "enum": ["A", "B", "C", "D", "E", "F"] }
        },
        "commissions": {
          "description": "Commissions of this section in the pool, whatever their category.",
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": ["graph"],
      "additionalProperties": false
    },
    "cooldown": {
      "oneOf": [
        { "const": "board_reset", "description": "Until the next board reset." },
        { "$ref": "#/$defs/duration" }
      ]
    },
    "commission": {
      "type": "object",
      "properties": {
        "category": { "enum": ["A", "B", "C", "D", "E", "F"] },
        "kind": { "enum": ["repeatable", "feat"] },
        "name": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "proof": { "$ref": "#/$defs/proof" },
        "cooldown": { "$ref": "#/$defs/cooldown", "description": "Repeatables only; default settings.default_cooldown." },
        "weight": { "type": "integer", "minimum": 1, "default": 1 },
        "in_rotation": { "type": "boolean", "default": true },
        "reward": { "$ref": "#/$defs/reward" }
      },
      "required": ["category", "kind", "name", "hint", "proof"],
      "additionalProperties": false,
      "if": { "properties": { "kind": { "const": "feat" } }, "required": ["kind"] },
      "then": { "not": { "required": ["cooldown"] } }
    },
    "proof": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["item", "criterion", "descent"] } },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "item" } } },
          "then": {
            "properties": {
              "type": true,
              "all_of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/itemEntry" } },
              "any_of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/itemEntry" } }
            },
            "oneOf": [ { "required": ["all_of"] }, { "required": ["any_of"] } ],
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "criterion" } } },
          "then": {
            "properties": {
              "type": true,
              "trigger": { "$ref": "#/$defs/id" },
              "conditions": { "type": "object" },
              "count": { "type": "integer", "minimum": 1, "default": 1 }
            },
            "required": ["trigger"],
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "descent" } } },
          "then": {
            "properties": {
              "type": true,
              "start": { "$ref": "#/$defs/id" },
              "finish": { "$ref": "#/$defs/id" }
            },
            "required": ["start", "finish"],
            "additionalProperties": false
          }
        }
      ]
    },
    "itemEntry": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object",
          "description": "A vanilla item predicate (items, components, predicates) without count.",
          "not": { "required": ["count"] }
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/itemCheck" } },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "consume": { "type": "boolean", "default": true }
      },
      "required": ["item"],
      "additionalProperties": false
    },
    "itemCheck": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["alina:bees", "alina:stew_effect", "alina:instrument_tag"] } },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "alina:bees" } } },
          "then": {
            "properties": {
              "type": true,
              "count": {
                "description": "A whole number, or { min, max }.",
                "oneOf": [
                  { "type": "integer" },
                  { "type": "object", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }, "additionalProperties": false }
                ]
              }
            },
            "required": ["count"],
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "alina:stew_effect" } } },
          "then": {
            "properties": { "type": true, "effect": { "$ref": "#/$defs/id" } },
            "required": ["effect"],
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "alina:instrument_tag" } } },
          "then": {
            "properties": { "type": true, "tag": { "$ref": "#/$defs/id" } },
            "required": ["tag"],
            "additionalProperties": false
          }
        }
      ]
    },
    "volume": {
      "type": "object",
      "properties": {
        "dimension": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/blockPos" },
        "to": { "$ref": "#/$defs/blockPos" }
      },
      "required": ["dimension", "from", "to"],
      "additionalProperties": false
    },
    "blockPos": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 3,
      "maxItems": 3
    },
    "achievements": {
      "description": "Achievement tabs and achievements, shown in the vanilla advancement screen.",
      "type": "object",
      "properties": {
        "tabs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/tab" }
        },
        "achievements": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/achievement" }
        }
      },
      "additionalProperties": false
    },
    "icon": {
      "description": "An item stack: an item id, or an object with id and optionally count and components. Leave out a count of 1, the default.",
      "oneOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "count": { "type": "integer", "minimum": 2, "maximum": 99 },
            "components": { "type": "object" }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      ]
    },
    "frame": { "enum": ["task", "goal", "challenge"] },
    "tab": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "icon": { "$ref": "#/$defs/icon" },
        "background": {
          "allOf": [ { "$ref": "#/$defs/id" }, { "not": { "pattern": "(^([a-z0-9_.-]+:)?textures/)|(\\.png$)" } } ],
          "description": "A texture id without textures/ and .png, as in vanilla: minecraft:gui/advancements/backgrounds/stone."
        }
      },
      "required": ["title", "icon"],
      "additionalProperties": false
    },
    "achievement": {
      "type": "object",
      "properties": {
        "tab": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "icon": { "$ref": "#/$defs/icon" },
        "frame": { "$ref": "#/$defs/frame", "default": "task" },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Withheld from the player until earned once. A hidden achievement cannot be a parent."
        },
        "announce": { "type": "boolean", "default": true },
        "toast": { "type": "boolean", "default": true },
        "criteria": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/criterion" }
        },
        "requirements": {
          "description": "Vanilla's AND of ORs over criterion names. Default: every criterion.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "tiers": {
          "description": "Count thresholds on the one criterion, rising.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tier" }
        },
        "repeat": {
          "type": "object",
          "properties": { "cooldown": { "$ref": "#/$defs/duration" } },
          "required": ["cooldown"],
          "additionalProperties": false
        },
        "reward": { "$ref": "#/$defs/reward" }
      },
      "required": ["tab", "title", "description", "icon", "criteria"],
      "additionalProperties": false,
      "if": { "required": ["tiers"] },
      "then": {
        "properties": {
          "criteria": { "maxProperties": 1, "additionalProperties": { "not": { "required": ["count"] } } }
        }
      }
    },
    "tier": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text" },
        "frame": { "$ref": "#/$defs/frame" },
        "reward": { "$ref": "#/$defs/reward" }
      },
      "required": ["count"],
      "additionalProperties": false
    },
    "trade": {
      "description": "Alina's trade section: the currency, the experience market, the price lists and the shops. With an experience_market every shop's experience is fees; without one it is rates.",
      "type": "object",
      "properties": {
        "currency": {
          "description": "The denominations. One has value 1, so any amount can be paid out.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/denomination" }
        },
        "experience_market": { "$ref": "#/$defs/experienceMarket" },
        "price_lists": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/priceList" }
        },
        "shops": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/shop" }
        }
      },
      "required": ["currency"],
      "if": { "required": ["experience_market"] },
      "then": {
        "properties": {
          "shops": {
            "additionalProperties": {
              "properties": {
                "experience": {
                  "properties": {
                    "sell": { "$ref": "#/$defs/fee" },
                    "buy": { "$ref": "#/$defs/fee" }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "shops": {
            "additionalProperties": {
              "properties": {
                "experience": {
                  "properties": {
                    "sell": { "$ref": "#/$defs/rate" },
                    "buy": { "$ref": "#/$defs/rate" }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "experienceMarket": {
      "description": "The one pool every experience broker of the section trades against.",
      "type": "object",
      "properties": {
        "reserve": {
          "description": "The seed reserves. Their ratio is the base rate, and the restock heads for them.",
          "type": "object",
          "properties": {
            "points": { "type": "integer", "minimum": 1000, "maximum": 1000000000 },
            "aur": { "type": "integer", "minimum": 1000, "maximum": 1000000000 }
          },
          "required": ["points", "aur"],
          "additionalProperties": false
        },
        "restock_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "How far each reserve moves back to the seed once per Guild board day, in percent."
        },
        "max_trade_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "The most of the reserve one trade may take from it, in percent."
        },
        "quote_tolerance_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0,
          "description": "How far, in percent of the quoted points, a market trade may have moved against the player since the quote and still go through. 0 refuses any difference."
        }
      },
      "required": ["reserve", "restock_percent"],
      "additionalProperties": false
    },
    "denomination": {
      "type": "object",
      "properties": {
        "item": { "$ref": "#/$defs/id", "description": "A registered item." },
        "value": { "type": "integer", "minimum": 1, "description": "The Aur the item stands for when it is paid out." }
      },
      "required": ["item", "value"],
      "additionalProperties": false
    },
    "priceList": {
      "type": "object",
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/sellRule" } }
      },
      "required": ["rules"],
      "additionalProperties": false
    },
    "sellRule": {
      "type": "object",
      "properties": {
        "match": {
          "type": "object",
          "description": "A vanilla item predicate without count. A predicate with components or predicates also takes modified stacks.",
          "not": { "required": ["count"] }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$",
          "description": "Every item of this namespace. Takes unmodified stacks only."
        },
        "price": { "$ref": "#/$defs/price" },
        "junk": { "type": "boolean", "default": false },
        "refuse": {
          "type": "boolean",
          "default": false,
          "description": "The shop takes none of the items, and no later rule of the shop is tried for them."
        }
      },
      "oneOf": [ { "required": ["match"] }, { "required": ["namespace"] } ],
      "if": { "properties": { "refuse": { "const": true } }, "required": ["refuse"] },
      "then": { "not": { "anyOf": [ { "required": ["price"] }, { "required": ["junk"] } ] } },
      "else": { "required": ["price"] },
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "aur": { "type": "integer", "minimum": 1 },
        "per": { "type": "integer", "minimum": 1, "maximum": 64, "description": "The number of items the Aur is for." }
      },
      "required": ["aur", "per"],
      "additionalProperties": false
    },
    "shop": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "sell": { "$ref": "#/$defs/sell", "description": "What players sell to the shop." },
        "buy": {
          "description": "What players buy from the shop.",
          "type": "array",
          "items": { "$ref": "#/$defs/offer" }
        },
        "experience": { "$ref": "#/$defs/experience" },
        "lines": { "$ref": "#/$defs/shopLines" }
      },
      "required": ["name"],
      "anyOf": [
        { "required": ["sell"] },
        { "required": ["experience"] },
        { "required": ["buy"], "properties": { "buy": { "minItems": 1 } } }
      ],
      "if": { "required": ["experience"], "properties": { "experience": { "required": ["sell"] } } },
      "then": { "required": ["sell"] },
      "additionalProperties": false
    },
    "sell": {
      "type": "object",
      "properties": {
        "daily_budget": { "type": "integer", "minimum": 1, "description": "The most Aur the shop pays players in one day." },
        "lists": {
          "description": "Price lists of this section. Their rules follow the shop's own rules, in this order.",
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "rules": {
          "description": "The shop's own rules, tried before the rules of its lists.",
          "type": "array",
          "items": { "$ref": "#/$defs/sellRule" }
        }
      },
      "required": ["daily_budget"],
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64, "description": "Unique within the shop." },
        "item": { "$ref": "#/$defs/stack" },
        "price": { "type": "integer", "minimum": 1, "description": "The Aur the stack's count of the item costs." },
        "limit": { "$ref": "#/$defs/limit" },
        "requires": { "$ref": "#/$defs/requires" }
      },
      "required": ["id", "item", "price"],
      "additionalProperties": false
    },
    "stack": {
      "description": "An item stack: an item id, and optionally a count and components. Leave out a count of 1, the default.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "count": { "type": "integer", "minimum": 2, "maximum": 99 },
        "components": { "type": "object" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "per": { "enum": ["day", "character"], "description": "How often the count applies: each day, or once per character." }
      },
      "required": ["count", "per"],
      "additionalProperties": false
    },
    "requires": {
      "description": "What a player needs before the offer is open to them: a reputation, an achievement, or both.",
      "type": "object",
      "properties": {
        "reputation": { "type": "integer" },
        "achievement": { "$ref": "#/$defs/id", "description": "Not checked against alina:achievements." }
      },
      "anyOf": [ { "required": ["reputation"] }, { "required": ["achievement"] } ],
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "properties": {
        "sell": {
          "description": "The experience a player sells to the shop: a rate, or a fee in a section with an experience_market.",
          "oneOf": [ { "$ref": "#/$defs/rate" }, { "$ref": "#/$defs/fee" } ]
        },
        "buy": {
          "description": "The experience a player buys from the shop: a rate, or a fee in a section with an experience_market.",
          "oneOf": [ { "$ref": "#/$defs/rate" }, { "$ref": "#/$defs/fee" } ]
        }
      },
      "anyOf": [ { "required": ["sell"] }, { "required": ["buy"] } ],
      "additionalProperties": false
    },
    "rate": {
      "type": "object",
      "properties": {
        "points": { "type": "integer", "minimum": 1 },
        "aur": { "type": "integer", "minimum": 1 }
      },
      "required": ["points", "aur"],
      "additionalProperties": false
    },
    "fee": {
      "description": "A shop's fee for one direction of experience, in a section with an experience_market.",
      "type": "object",
      "properties": {
        "fee_percent": { "type": "integer", "minimum": 0, "maximum": 50, "description": "The fee, in percent." }
      },
      "required": ["fee_percent"],
      "additionalProperties": false
    },
    "shopLines": {
      "description": "The player-facing lines of a shop. Each is optional.",
      "type": "object",
      "properties": {
