  "dialogues": {
    "lampas:guild/receptionist": {
      "start": "hello",
      "nodes": {
        "hello": {
          "text": "Welcome to the Guild. What do you need?",
          "choices": [
            { "text": "Show me today's board.", "next": "daily" },
            { "text": "Show me the feats.", "next": "feats" },
            { "text": "I have a commission to turn in.", "next": "turn_in" },
            { "text": "I want to drop a commission.", "next": "abandon" },
            { "text": "What is my record?", "next": "status" },
            { "text": "Goodbye.", "next": "bye" }
          ]
        },
        "daily": {
          "text": "Today's board. Pick a commission to accept.",
          "choices": [
            { "provider": { "type": "alina:guild/board", "board": "lampas:guild/daily", "next": "daily" } },
            { "text": "Back.", "next": "hello" }
          ]
        },
        "feats": {
          "text": "The feats. Each one is done once.",
          "choices": [
            { "provider": { "type": "alina:guild/board", "board": "lampas:guild/feats", "next": "feats" } },
            { "text": "Back.", "next": "hello" }
          ]
        },
        "turn_in": {
          "text": "Which commission is done?",
          "choices": [
            { "provider": { "type": "alina:guild/turn_in", "next": "turn_in" } },
            { "text": "Back.", "next": "hello" }
          ]
        },
        "abandon": {
          "text": "Which commission do you drop? It frees its place with no reward.",
          "choices": [
            { "provider": { "type": "alina:guild/abandon", "next": "abandon" } },
            { "text": "Back.", "next": "hello" }
          ]
        },
        "status": {
          "text": "Your standing with the Guild.",
          "choices": [
            { "provider": { "type": "alina:guild/status" } },
            { "text": "Back.", "next": "hello" }
          ]
        },
        "bye": { "text": "Safe travels." }
      }
    },
